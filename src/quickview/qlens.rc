// QLens QuickView 资源——图标 + 版本
#include <windows.h>
#define IDI_QLENS 101
IDI_QLENS ICON "QLens.ico"

#define VER_MAJOR 0
#define VER_MINOR 2
#define VER_BUILD 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_BUILD,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_BUILD,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "QLens"
            VALUE "FileDescription", "QLens QuickView"
            VALUE "FileVersion", "0.2.0"
            VALUE "ProductName", "QLens"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
